# Copia este archivo a .env.local para desarrollo y añade las mismas variables en Vercel.

# URL pública de la web (sin barra final). Se usa en SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dgital.io

# Enlace de Calendly del diagnóstico de 30 min (botones y embed en /contacto).
NEXT_PUBLIC_CALENDLY_URL=

# Demo: "true" = procesa los correos con Claude (necesita ANTHROPIC_API_KEY).
# Vacío o "false" = demo con resultados de ejemplo, sin IA ni coste.
NEXT_PUBLIC_DEMO_IA=

# API key de Anthropic (solo servidor, nunca se expone al navegador). Solo si NEXT_PUBLIC_DEMO_IA=true.
ANTHROPIC_API_KEY=

# OPCIONAL. Límite exacto de usos de la demo (5/IP/día y 300/día en total). Sin estas variables
# se usa un limitador en memoria aproximado. Protección principal: tope de gasto en la consola de Anthropic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Valor aleatorio para cifrar (hash) las IPs del limitador.
DEMO_SALT=

# Analítica: "plausible" (sin cookies, sin banner) o "ga4" (con banner de consentimiento). Vacío = sin analítica.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=
